{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiBar",
  "version": "0.1.0",
  "identifier": "app.pibar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PiBar",
        "width": 1320,
        "height": 840,
        "minWidth": 620,
        "dragDropEnabled": false,
        "minHeight": 600
      },
      {
        "label": "quick",
        "url": "quick.html",
        "title": "PiBar Quick",
        "width": 920,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}