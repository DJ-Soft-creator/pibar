# Copy to .env and fill in. Never commit .env — placeholders only here.

# Port the server listens on
PORT=8787

# Directory for users/tokens/config JSON files.
# Docker sets DATA_DIR=/data (named volume) via docker-compose.yml — do NOT set
# it here for Docker, or the volume would be bypassed and data lost on recreate.
# DATA_DIR=./data

# Bootstrap admin, created only on first start when no users are persisted.
# Default username is "admin". If ADMIN_PASSWORD is unset, a random password is
# generated and printed ONCE to the server log — that is the recommended default.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Optional: override the static client directory (default ./src/client)
# CLIENT_DIR=./src/client
